# Copy this file to .env and fill real values. Do not commit .env.

# PostgreSQL local database. Preferred for local development.
# Example:
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/healthguard_ai
DATABASE_URL=

# SQLite fallback DB path. Optional, used only when DATABASE_URL is empty.
HEALTHGUARD_DB_PATH=

# SMTP email delivery. Required for real email confirmation.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# SMTP_FROM=your-gmail-address@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# SSO client IDs. Provider secrets/token exchange still need production setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/sso/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8001/api/auth/sso/facebook/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8001/api/auth/sso/instagram/callback

# LLM provider. Use gemini, huggingface, or openai.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_RETRY_COUNT=4
GEMINI_RETRY_DELAY_SECONDS=3
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=openai/gpt-oss-120b:cerebras
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MAX_TOKENS=900
HUGGINGFACE_ASR_MODEL=openai/whisper-large-v3-turbo
HUGGINGFACE_ASR_FALLBACK_MODELS=openai/whisper-small,openai/whisper-base
HUGGINGFACE_ASR_BASE_URL=https://router.huggingface.co/hf-inference/models
HUGGINGFACE_ASR_TIMEOUT_SECONDS=45
HUGGINGFACE_ASR_RETRY_COUNT=2
HUGGINGFACE_ASR_RETRY_DELAY_SECONDS=1.5
HEALTHGUARD_VOICE_MAX_BYTES=10485760
HEALTHGUARD_VOICE_MIN_BYTES=1024
LLM_TIMEOUT_SECONDS=25
